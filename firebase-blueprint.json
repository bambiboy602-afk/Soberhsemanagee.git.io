{
  "entities": {
    "house": {
      "title": "House",
      "description": "Sober living house",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the house" },
        "managerId": { "type": "string", "description": "UID of the manager" }
      },
      "required": ["name", "managerId"]
    },
    "resident": {
      "title": "Resident",
      "description": "A resident in the house",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Resident name" },
        "moveInDate": { "type": "string", "format": "date", "description": "Date of move in" },
        "sobrietyStatus": { "type": "string", "enum": ["sober", "relapsed", "unknown"], "description": "Current sobriety status" },
        "houseId": { "type": "string", "description": "House ID" }
      },
      "required": ["name", "moveInDate", "sobrietyStatus", "houseId"]
    },
    "rule": {
      "title": "Rule",
      "description": "A house rule",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "The rule text" },
        "houseId": { "type": "string", "description": "House ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When added" }
      },
      "required": ["description", "houseId", "createdAt"]
    },
    "chore": {
      "title": "Chore",
      "description": "A household chore",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "Chore description" },
        "houseId": { "type": "string", "description": "House ID" },
        "assignedTo": { "type": "string", "description": "Resident ID" },
        "isCompleted": { "type": "boolean", "description": "Completion status" },
        "dueDate": { "type": "string", "format": "date", "description": "Due date" }
      },
      "required": ["description", "houseId", "isCompleted"]
    },
    "meeting": {
      "title": "Meeting",
      "description": "A house meeting",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Meeting name" },
        "date": { "type": "string", "format": "date", "description": "Date of meeting" },
        "houseId": { "type": "string", "description": "House ID" }
      },
      "required": ["name", "date", "houseId"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Attendance record for a resident",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "attended": { "type": "boolean", "description": "Whether attended" }
      },
      "required": ["residentId", "attended"]
    },
    "checkIn": {
      "title": "Daily Check-in",
      "description": "Daily check-in for a resident",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "mood": { "type": "string", "description": "Resident's mood" },
        "sobrietyStatus": { "type": "string", "enum": ["sober", "struggling"], "description": "Sobriety status" },
        "comments": { "type": "string", "description": "Additional comments" },
        "date": { "type": "string", "format": "date", "description": "Check-in date" }
      },
      "required": ["residentId", "mood", "sobrietyStatus", "date"]
    },
    "scheduleEntry": {
      "title": "Schedule Entry",
      "description": "Weekly schedule entry",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "type": { "type": "string", "description": "Work, treatment, etc." },
        "dayOfWeek": { "type": "integer", "description": "0-6" },
        "startTime": { "type": "string", "description": "HH:MM" },
        "endTime": { "type": "string", "description": "HH:MM" }
      },
      "required": ["residentId", "type", "dayOfWeek", "startTime", "endTime"]
    },
    "passRequest": {
      "title": "Pass Request",
      "description": "Request for a pass",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "type": { "type": "string", "enum": ["local", "overnight", "travel"], "description": "Type of pass" },
        "reason": { "type": "string", "description": "Reason for the pass" },
        "startTime": { "type": "string", "description": "ISO timestamp" },
        "endTime": { "type": "string", "description": "ISO timestamp" },
        "status": { "type": "string", "enum": ["pending", "approved", "denied"], "description": "Request status" },
        "managerNote": { "type": "string", "description": "Optional note from manager" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When requested" }
      },
      "required": ["residentId", "houseId", "type", "reason", "startTime", "endTime", "status", "createdAt"]
    },
    "movementRecord": {
      "title": "Movement Record",
      "description": "Sign in/out record",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "type": { "type": "string", "enum": ["sign-in", "sign-out"], "description": "Sign-in or out" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When it happened" }
      },
      "required": ["residentId", "type", "timestamp"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "House announcement",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "Announcement content" },
        "houseId": { "type": "string", "description": "House ID" },
        "date": { "type": "string", "format": "date-time", "description": "Date of announcement" }
      },
      "required": ["content", "houseId", "date"]
    },
    "incident": {
      "title": "Incident",
      "description": "Incident report",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "Incident details" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"], "description": "Severity level" },
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "date": { "type": "string", "format": "date-time", "description": "Date of incident" }
      },
      "required": ["description", "severity", "residentId", "houseId", "date"]
    },
    "goal": {
      "title": "Goal",
      "description": "A recovery goal for a resident",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Goal title" },
        "description": { "type": "string", "description": "Detailed goal description" },
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "status": { "type": "string", "enum": ["active", "completed", "abandoned"], "description": "Status of the goal" },
        "progress": { "type": "integer", "description": "Percentage progress (0-100)" },
        "targetDate": { "type": "string", "format": "date", "description": "Target date for completion" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When created" },
        "lastUpdated": { "type": "string", "format": "date-time", "description": "Last progress update" }
      },
      "required": ["title", "residentId", "houseId", "status", "progress", "createdAt"]
    },
    "moodLog": {
      "title": "Mood Log",
      "description": "Daily emotional state log",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "score": { "type": "integer", "description": "Mood score (1-5)" },
        "note": { "type": "string", "description": "Optional note" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Log timestamp" }
      },
      "required": ["residentId", "houseId", "score", "timestamp"]
    },
    "safetyPlan": {
      "title": "Crisis Safety Plan",
      "description": "Resident emergency plan",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "emergencyContacts": { "type": "array", "description": "List of contacts" },
        "triggers": { "type": "array", "description": "List of triggers" },
        "copingStrategies": { "type": "array", "description": "List of strategies" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update" }
      },
      "required": ["residentId", "houseId", "updatedAt"]
    },
    "supportRequest": {
      "title": "Support Request",
      "description": "Request for manager support",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "message": { "type": "string", "description": "Optional message" },
        "status": { "type": "string", "enum": ["pending", "resolved"], "description": "Request status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["residentId", "houseId", "status", "createdAt"]
    },
    "complianceForm": {
      "title": "Compliance Form",
      "description": "Signed compliance document",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "type": { "type": "string", "enum": ["program-terms", "house-rules", "treatment-plan"], "description": "Form type" },
        "formData": { "type": "object", "description": "Form fields" },
        "signedAt": { "type": "string", "format": "date-time", "description": "Signature timestamp" },
        "signedByName": { "type": "string", "description": "Full name of signer" }
      },
      "required": ["residentId", "houseId", "type", "formData", "signedAt", "signedByName"]
    },
    "affirmation": {
      "title": "Daily Affirmation",
      "description": "Inspirational quote",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Affirmation text" },
        "houseId": { "type": "string", "description": "House ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["text", "houseId", "createdAt"]
    },
    "specialNote": {
      "title": "Special Note",
      "description": "Special instruction or note for a resident",
      "type": "object",
      "properties": {
        "residentId": { "type": "string", "description": "Resident ID" },
        "houseId": { "type": "string", "description": "House ID" },
        "content": { "type": "string", "description": "Note content" },
        "createdBy": { "type": "string", "description": "Manager UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["residentId", "houseId", "content", "createdBy", "createdAt"]
    },
    "user": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "User email" },
        "role": { "type": "string", "enum": ["resident", "manager"], "description": "User role" },
        "houseId": { "type": "string", "description": "House ID" },
        "residentId": { "type": "string", "description": "Resident ID if resident" }
      },
      "required": ["email", "role", "houseId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "user",
      "description": "User roles/profiles"
    },
    "/houses/{houseId}": {
      "schema": "house",
      "description": "House documents"
    },
    "/houses/{houseId}/residents/{residentId}": {
      "schema": "resident",
      "description": "Residents per house"
    },
    "/houses/{houseId}/rules/{ruleId}": {
      "schema": "rule",
      "description": "Rules per house"
    },
    "/houses/{houseId}/chores/{choreId}": {
      "schema": "chore",
      "description": "Chores per house"
    },
    "/houses/{houseId}/meetings/{meetingId}": {
      "schema": "meeting",
      "description": "Meetings per house"
    },
    "/houses/{houseId}/meetings/{meetingId}/attendance/{residentId}": {
      "schema": "attendance",
      "description": "Attendance records per meeting"
    },
    "/houses/{houseId}/checkins/{checkInId}": {
      "schema": "checkIn",
      "description": "Daily check-ins per house"
    },
    "/houses/{houseId}/schedule/{entryId}": {
      "schema": "scheduleEntry",
      "description": "Weekly schedules"
    },
    "/houses/{houseId}/passRequests/{requestId}": {
      "schema": "passRequest",
      "description": "Pass requests"
    },
    "/houses/{houseId}/movements/{movementId}": {
      "schema": "movementRecord",
      "description": "Movement records"
    },
    "/houses/{houseId}/announcements/{announcementId}": {
      "schema": "announcement",
      "description": "Announcements per house"
    },
    "/houses/{houseId}/incidents/{incidentId}": {
      "schema": "incident",
      "description": "Incidents per house"
    },
    "/houses/{houseId}/goals/{goalId}": {
      "schema": "goal",
      "description": "Resident goals"
    },
    "/houses/{houseId}/moodLogs/{logId}": {
      "schema": "moodLog",
      "description": "Resident mood logs"
    },
    "/houses/{houseId}/safetyPlans/{residentId}": {
      "schema": "safetyPlan",
      "description": "Resident safety plans"
    },
    "/houses/{houseId}/supportRequests/{requestId}": {
      "schema": "supportRequest",
      "description": "Support requests"
    },
    "/houses/{houseId}/complianceForms/{formId}": {
      "schema": "complianceForm",
      "description": "Resident compliance documents"
    },
    "/houses/{houseId}/affirmations/{affirmationId}": {
      "schema": "affirmation",
      "description": "House-specific affirmations"
    },
    "/houses/{houseId}/specialNotes/{noteId}": {
      "schema": "specialNote",
      "description": "Special resident notes"
    }
  }
}
